# Название в шапке и в сообщениях бота
APP_NAME=AniMini

# Домен, на который смотрит A-запись вашего VPS. Caddy выпустит для него HTTPS.
DOMAIN=anime.example.com
# Публичный адрес приложения — его открывает Mini App и он идёт в кнопки бота
SITE_URL=https://anime.example.com

# Токен от @BotFather. Без него приложение работает как обычный сайт:
# прогресс и избранное хранятся в браузере, уведомлений нет.
BOT_TOKEN=
# Короткое имя Mini App из BotFather (/newapp). Нужно для ссылок вида t.me/<бот>/<имя>?startapp=...
BOT_APP_SHORT_NAME=

# Источник аниме
ANILIBERTY_API=https://aniliberty.top/api/v1
ANILIBERTY_MEDIA=https://aniliberty.top

# Токен Kodik для выбора озвучек других студий (AniDub, Studio Band…). Выдают по запросу
# на support@kodik.biz. Без него на странице просмотра будет общий плеер Kodik с выбором внутри.
KODIK_TOKEN=

# Плееры с 1080p и множеством озвучек. Видео хранят они сами; ID и токен выдают после
# регистрации сайта. CVH ищет аниме по ID Shikimori, Alloha — по ID Кинопоиска.
CVH_PUBLISHER_ID=
# Поддомен для плеера CVH с A-записью на этот сервер, например player.anime.example.com.
# Скрипты CVH работают на нём и не видят данные входа зрителей. Без него CVH выключен.
PLAYER_DOMAIN=
ALLOHA_TOKEN=
# Где искать ID Кинопоиска для Alloha, если нет токена Kodik. Пусто — не искать.
# В России Shikimori заблокирован: с российского сервера ID найдутся только через Kodik.
# SHIKIMORI_URL=https://shikimori.io

# Торрент-плеер (тест): серии прямо из торрент-раздач — 1080p, 4K и все озвучки раздачи.
# Раздачи добавляются командой: sudo animini torrent add <тайтл> <magnet>
TORRENTS=0
# TORRENT_CACHE_GB=10
# TORRENT_SESSIONS=2
# TORRENT_UPLOAD_KBPS=1000

# 1 — пропускать видео через свой сервер. Нужно, если CDN не отдаёт CORS
# или недоступен у зрителей. Весь трафик видео пойдёт через ваш VPS!
HLS_PROXY=0
# Дополнительные хосты видео для прокси через запятую (обычно не нужно)
HLS_HOSTS=

# Как часто проверять новые серии для уведомлений, минут
NOTIFY_INTERVAL_MIN=10
