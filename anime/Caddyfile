{
	# HTTP/3 (QUIC по UDP) провайдеры часто режут: браузер и Telegram на iPhone
	# тогда долго висят, прежде чем откатиться на HTTP/2. Оставляем только h1 и h2.
	servers {
		protocols h1 h2
	}
}

# PLAYER_DOMAIN — поддомен для плеера CVH (если включён). Приложение само следит,
# чтобы на нём открывались только страницы плеера.
{$DOMAIN} {$PLAYER_DOMAIN} {
	# Если клиент успел запомнить HTTP/3 с прошлой версии — пусть забудет.
	header Alt-Svc clear
	encode zstd gzip
	reverse_proxy app:3000
}
