{
  "name": "animini",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Аниме-приложение: сайт и Telegram Mini App с ботом и своим HLS-плеером",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env --watch server/index.ts",
    "dev:web": "vite web",
    "dev:mock": "node dev/mock-anilibria.ts",
    "build": "vite build web",
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env server/index.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p web/tsconfig.json",
    "test": "node --disable-warning=ExperimentalWarning --test --test-reporter=spec \"server/**/*.test.ts\""
  },
  "dependencies": {
    "@fastify/static": "^8.3.0",
    "fastify": "^5.12.5",
    "grammy": "^1.46.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "hls.js": "^1.7.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
