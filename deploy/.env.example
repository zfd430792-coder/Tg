# Copy to .env next to docker-compose.yml and fill in the values.
# Every Pentaract variable below is required: the server exits at start if one is missing.

# Public address served by Caddy (HTTPS certificate is issued automatically)
DOMAIN=files.example.duckdns.org

# Pentaract listens on 8000 inside the container; keep it as is
PORT=8000
WORKERS=4
CHANNEL_CAPACITY=32

# Admin account, created on the first start only
SUPERUSER_EMAIL=admin@tg.local
SUPERUSER_PASS=change-me

# Login session length (no refresh tokens in Pentaract); the second value is unused but required
ACCESS_TOKEN_EXPIRE_IN_SECS=86400
REFRESH_TOKEN_EXPIRE_IN_DAYS=14

# JWT signing key: openssl rand -hex 32
SECRET_KEY=change-me
TELEGRAM_API_BASE_URL=https://api.telegram.org

# Postgres; the password is applied on the first start only
DATABASE_USER=pentaract
DATABASE_PASSWORD=change-me
DATABASE_NAME=pentaract
DATABASE_HOST=db
DATABASE_PORT=5432
