{
	# HTTP/3 (QUIC over UDP) is often throttled by ISPs; browsers then stall for
	# seconds before falling back. Serve HTTP/1.1 and HTTP/2 only.
	servers {
		protocols h1 h2
	}
}

{$DOMAIN} {
	# API goes to Pentaract; open sign-up is closed (accounts are handed out by the admin).
	handle /api/* {
		@register {
			method POST
			path /api/users /api/users/
		}
		respond @register "Регистрация закрыта: доступ выдаёт администратор" 403

		reverse_proxy pentaract:8000
	}

	# Font files have content-hashed names, so they can be cached for good.
	handle /assets/fonts/* {
		root * /srv/ui
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Everything else is the web UI from ./ui; unknown paths fall back to index.html.
	handle {
		root * /srv/ui
		encode zstd gzip
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
